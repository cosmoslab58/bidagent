# BidAgent Configuration
# Copy to .env and fill in your values

PORT=8000
HOST_PORT=8000

# LLM: Anthropic Claude via the official anthropic SDK
ANTHROPIC_API_KEY=your_api_key_here
LLM_MODEL_NAME=claude-haiku-5-5
QUOTE_MODEL_NAME=claude-sonnet-5-5

# Twenty CRM (for live pricing)
TWENTY_CRM_API_URL=
TWENTY_CRM_BEARER_TOKEN=

# Active skill profile (must match a .yaml file in skills/)
ACTIVE_SKILL=curbclass
